# คัดลอกเป็น .env แล้วแก้ค่า (docker compose อ่านไฟล์นี้) · .env ไม่ถูก commit เพราะอาจมีรหัสผ่าน

# MongoDB ของ Import Service (Mornitor อ่านอย่างเดียว)
# ใน Docker "localhost" คือตัว container เอง ถ้า MongoDB อยู่บนเครื่องนี้ให้ใช้ host.docker.internal
MORNITOR_DB_URI=mongodb://host.docker.internal:27017
MORNITOR_DB_NAME=mornitor_source

# ไม่บังคับ: ps_requirements อยู่คนละ database (ค่าเริ่มต้น = database ด้านบน)
# MORNITOR_CONFIG_DB_URI=mongodb://host.docker.internal:27017
# MORNITOR_CONFIG_DB_NAME=mornitor_config

# ไม่บังคับ: ที่ Mornitor เขียน monitoring_results (ยืนยัน / User Review / บันทึกผล)
# ค่าเริ่มต้น = database ด้านบน · ตั้งแยกถ้าไม่ต้องการให้มีการเขียนใน database ของ Import Service
# MORNITOR_RESULTS_DB_URI=mongodb://host.docker.internal:27017
# MORNITOR_RESULTS_DB_NAME=mornitor_results

# ไม่บังคับ: ปีในข้อมูลเป็น พ.ศ. ใช้ 543 (ค่าเริ่มต้น) · เป็น ค.ศ. ใช้ 0
# MORNITOR_YEAR_OFFSET=543

# ไม่บังคับ: ใช้เฉพาะเมื่อหน้าเว็บจาก origin อื่นเรียก API ตรง (หน้าเว็บใน Docker ไม่ต้องใช้)
# MORNITOR_CORS_ORIGINS=http://localhost:5173

# เซ็น session cookie ของ PS-03/PS-06 Manual Review (python -c "import secrets; print(secrets.token_hex(32))")
# ถ้าไม่ตั้งจะใช้ค่า default ที่ไม่ปลอดภัย (ใครก็ปลอม session ได้) — ต้องตั้งเองก่อนใช้งานจริง
MORNITOR_SESSION_SECRET=

# ไม่บังคับ: session หมดอายุกี่วินาทีหลัง login (ค่าเริ่มต้น 28800 = 8 ชั่วโมง)
# MORNITOR_SESSION_TTL_SECONDS=28800

# ไม่บังคับ: ตั้งเป็น true เฉพาะเมื่อมี HTTPS จริงหน้า service นี้ (reverse proxy ที่ทำ TLS)
# ค่าเริ่มต้น false เพราะ compose.yaml นี้เสิร์ฟเป็น HTTP เปิดเฉพาะเครื่องนี้ — ถ้าตั้ง true โดยไม่มี HTTPS
# จริง เบราว์เซอร์จะไม่ส่ง cookie กลับมาเลย และ login จะดูเหมือนไม่ติดทุกครั้ง
# MORNITOR_COOKIE_SECURE=true

# พอร์ตบนเครื่องนี้ (เปิดเฉพาะ 127.0.0.1)
MORNITOR_WEB_PORT=8080
MORNITOR_API_PORT=8000
