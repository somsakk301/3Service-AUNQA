# Base URL of the Generator Service's REST API (api_server.py / uvicorn).
VITE_API_BASE_URL=http://localhost:8010

# Set to "false" once the backend gaps noted in src/services/api/*.ts are
# filled in (HTML preview, draft save, history, reference endpoints).
# Defaults to true (mock adapters) so Generate/History/Reference can be
# exercised end-to-end in this standalone Development Mode build.
VITE_USE_MOCK_API=true

# Development/Test ONLY (requires VITE_USE_MOCK_API=false AND a backend started with
# GENERATOR_DEV_MODE=true). "true" makes Generate call POST /api/dev/generate (real Generator,
# Monitor gate bypassed) instead of the production, Monitor-gated POST /api/generate.
# Leave unset/false for production behavior.
VITE_DEV_GENERATE=false
