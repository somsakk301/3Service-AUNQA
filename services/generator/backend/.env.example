# Same MongoDB Atlas cluster/database the Import Service writes to
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=aunqa

# Same ChromaDB server the Import Service writes embeddings to
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=document_chunks

# Gemini API key - used for Criterion Agent JSON generation only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CRITERIA_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Query-side embedding for ChromaDB search (common/bge_embedding.py). MUST
# match the model the Import Service used to embed `document_chunks` -
# query vectors and stored vectors have to come from the same embedding
# model or similarity search is meaningless (and Chroma rejects a
# dimension mismatch outright). Real document_chunks were embedded with
# BGE-M3 (1024-dim), not Gemini.
BGE_M3_MODEL=BAAI/bge-m3

# Master Config JSON (criterion order, keywords, evidence requirements)
MASTER_CONFIG_PATH=./master_config.json

# Where the completed SAR .docx is written
OUTPUT_DIR=./output

# Template Service HTTP API (common/template_client.py) - downloads the SAR
# Template file itself (template_ps only stores metadata + a path on
# whatever machine the Import Service runs on, which this Generator
# Service instance may not be able to read directly). Leave unset until a
# real Template Service is deployed - get_sar_template() will correctly
# report "not found" rather than falling back to a stale/local file.
# TEMPLATE_SERVICE_URL=http://10.200.28.47:8080
TEMPLATE_SERVICE_TIMEOUT_SECONDS=15.0

# Retrieval
EVIDENCE_TOP_K=6

# Verification gates
RAPIDFUZZ_THRESHOLD=80
SEMANTIC_SIMILARITY_THRESHOLD=0.45
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MAX_VERIFICATION_RETRIES=3

# Testing only - nudges the Criteria Agent to write best-effort content from
# available Evidence instead of defaulting to gap_analysis=missing when a
# criterion's guideline/required_evidence are empty (pending real Evidence).
# Set back to false (or remove) once real Evidence is in place - see
# README.md's "Guideline lives in master_config.json" section.
TEST_MODE_FORCE_CONTENT=false

# api_server.py only - origin(s) allowed to call it (the Import Service
# frontend's "Generate SAR" page). Not used by the CLI (master_agent.master).
CORS_ORIGINS=http://localhost:5173

# Monitor Service integration (monitor/client.py) - real, confirmed
# contract: GET {MONITOR_SERVICE_URL}{MONITOR_READINESS_PATH (with
# {curriculum_id} filled in)} -> {"generatedReady": true|false}. Leave
# MONITOR_SERVICE_URL unset until a real Monitor is deployed - POST
# /api/generate will correctly report MONITOR_UNAVAILABLE and refuse to
# generate rather than assuming READY. Point this at the real Monitor
# later; no code change needed.
# MONITOR_SERVICE_URL=https://monitor.example.internal
MONITOR_READINESS_PATH=/monitor/{curriculum_id}/readiness
MONITOR_TIMEOUT_SECONDS=5.0
# Placeholder only - the real auth mechanism isn't confirmed yet, so this is
# not attached to requests by any code path yet.
# MONITOR_AUTH_TOKEN=
