.env
.pytest_cache/
__pycache__/
*.py[cod]

# Keep the required project-data directory tree, but not runtime data.
project-data/mongodb/*
!project-data/mongodb/.gitkeep
project-data/chromadb/*
!project-data/chromadb/.gitkeep
project-data/models/*
!project-data/models/.gitkeep
project-data/documents/original/curriculum/*
!project-data/documents/original/curriculum/.gitkeep
project-data/documents/original/cv/*
!project-data/documents/original/cv/.gitkeep
project-data/documents/original/appointment/*
!project-data/documents/original/appointment/.gitkeep
project-data/documents/converted/curriculum/*
!project-data/documents/converted/curriculum/.gitkeep
project-data/documents/converted/cv/*
!project-data/documents/converted/cv/.gitkeep
project-data/documents/converted/appointment/*
!project-data/documents/converted/appointment/.gitkeep
project-data/documents/extracted/curriculum/*
!project-data/documents/extracted/curriculum/.gitkeep
project-data/documents/extracted/cv/*
!project-data/documents/extracted/cv/.gitkeep
project-data/documents/extracted/appointment/*
!project-data/documents/extracted/appointment/.gitkeep
project-data/documents/generated/*
!project-data/documents/generated/.gitkeep
